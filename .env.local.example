# ============================================
# ViralClip AI - Variables de entorno
# Copia este archivo a .env.local y rellena tus keys
# ============================================

# Transcripción (recomendado: Groq, gratis en console.groq.com)
GROQ_API_KEY=

# Análisis de momentos virales + fallback de transcripción
OPENAI_API_KEY=

# Directorios de trabajo (opcional, por defecto ./data y ./output)
DATA_DIR=./data
OUTPUT_DIR=./output

# Intervalo de escaneo de canales del worker, en minutos (opcional)
SCAN_INTERVAL_MIN=30
